#include <ESP8266WiFi.h>
#include <PubSubClient.h>

// ── Pin config ───────────────────────────────────────
#define RELAY_PIN D1   // Controls the appliance via relay

// ── Wi-Fi credentials ────────────────────────────────
const char* ssid     = "YOUR_WIFI_SSID";
const char* password = "YOUR_WIFI_PASSWORD";

// ── MQTT broker config ───────────────────────────────
const char* mqtt_server   = "broker.hivemq.com";  // Free public broker
const int   mqtt_port     = 1883;
const char* client_id     = "NodeMCU_LivingRoom";

// ── MQTT topics ──────────────────────────────────────
const char* topic_command = "home/livingroom/light/set";
const char* topic_status  = "home/livingroom/light/status";

WiFiClient   espClient;
PubSubClient mqtt(espClient);

// ── Wi-Fi connection ─────────────────────────────────
void connectWiFi() {
  Serial.print("Connecting to Wi-Fi");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nWi-Fi connected. IP: " + WiFi.localIP().toString());
}

// ── MQTT callback (fires on incoming message) ────────
void onMessage(char* topic, byte* payload, unsigned int length) {
  String msg = "";
  for (unsigned int i = 0; i < length; i++) {
    msg += (char)payload[i];
  }

  Serial.println("Message received on [" + String(topic) + "]: " + msg);

  if (msg == "ON") {
    digitalWrite(RELAY_PIN, HIGH);
    mqtt.publish(topic_status, "ON");
    Serial.println("Relay ON → Appliance switched ON");
  } else if (msg == "OFF") {
    digitalWrite(RELAY_PIN, LOW);
    mqtt.publish(topic_status, "OFF");
    Serial.println("Relay OFF → Appliance switched OFF");
  } else {
    Serial.println("WARNING: Unknown command received.");
  }
}

// ── MQTT reconnect logic ─────────────────────────────
void reconnectMQTT() {
  while (!mqtt.connected()) {
    Serial.print("Connecting to MQTT broker...");
    if (mqtt.connect(client_id)) {
      Serial.println("connected.");
      mqtt.subscribe(topic_command);
      mqtt.publish(topic_status, "ONLINE");  // Announce presence
    } else {
      Serial.printf("Failed (rc=%d). Retrying in 3s...\n", mqtt.state());
      delay(3000);
    }
  }
}

// ── Setup ────────────────────────────────────────────
void setup() {
  Serial.begin(115200);
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, LOW);  // Start with appliance OFF

  connectWiFi();
  mqtt.setServer(mqtt_server, mqtt_port);
  mqtt.setCallback(onMessage);
}

// ── Main loop ────────────────────────────────────────
void loop() {
  if (!mqtt.connected()) {
    reconnectMQTT();
  }
  mqtt.loop();  // Keeps connection alive and processes messages
}
